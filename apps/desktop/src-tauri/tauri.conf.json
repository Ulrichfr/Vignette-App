{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vignette",
  "version": "0.1.0",
  "identifier": "com.ulrichrozier.vignette",
  "build": {
    "beforeDevCommand": "pnpm --filter @vignette/web dev",
    "devUrl": "http://localhost:5183/app/",
    "beforeBuildCommand": "pnpm --filter @vignette/web build:desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vignette",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NEMwMTFBQ0U3MTBDRjMKUldUekRISE9HZ0ZNZFM5RSs0ZHRSZWxBa3pWdThDTU9hTDlobFJYb0RadWlRc29iSXVuRVdFMWsK",
      "endpoints": [
        "https://vignette.ulrichrozier.com/dl/updater.json"
      ]
    }
  }
}
