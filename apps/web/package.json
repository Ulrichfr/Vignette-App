{
  "name": "@vignette/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && VITE_SUPABASE_URL= vite build",
    "build:dev-url": "tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && VITE_SUPABASE_URL= VITE_SUPABASE_ANON_KEY= vite build --base ./",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@supabase/supabase-js": "^2.48.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vignette/core": "workspace:*",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
