# Routage Vignette — mêmes réécritures que le gateway officiel Supabase
# (/auth/v1 → /, /rest/v1 → /, /realtime/v1 → /socket, /realtime/v1/api → /api).

:80 {
	# CORS préflight (rôle tenu par Kong dans la stack officielle) ; les
	# réponses réelles portent déjà les en-têtes CORS de GoTrue/PostgREST.
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "*"
		header Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, prefer, range, accept-profile, content-profile, x-supabase-api-version, x-upsert"
		header Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, OPTIONS"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}

	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy rest:3000
	}

	handle /realtime/v1/api/* {
		uri strip_prefix /realtime/v1
		reverse_proxy realtime-dev.vignette-realtime:4000 {
			header_up Host {upstream_hostport}
		}
	}

	handle /realtime/v1/* {
		# une seule directive : rewrite s'exécute avant uri dans l'ordre Caddy
		uri path_regexp ^/realtime/v1 /socket
		reverse_proxy realtime-dev.vignette-realtime:4000 {
			header_up Host {upstream_hostport}
		}
	}

	# Web app (zone membre) sous /app — build de apps/web (base /app/).
	handle /app* {
		root * /srv
		try_files {path} /app/index.html
		file_server
	}

	# Back office sous /admin — build de apps/admin (base /admin/).
	handle /admin* {
		root * /srv
		try_files {path} /admin/index.html
		file_server
	}

	# Landing / site vitrine à la racine (apps/site, statique).
	handle {
		root * /srv/site
		try_files {path} {path}.html /index.html
		file_server
	}
}
